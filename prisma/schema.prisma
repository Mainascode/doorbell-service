generator client {
 provider = "prisma-client-js"
}
datasource db {
 provider = "postgresql"
 url = env("DATABASE_URL")
}

enum Role {
 CUSTOMER
 ADMIN
}
enum OrderStatus {
 REQUESTED
 ACCEPTED
 SHOPPING
 ON_THE_WAY
 DELIVERED
 COMPLETED
 REJECTED
 CANCELLED
}
enum WeatherMode {
 NORMAL
 RAIN
}
enum PaymentStatus {
 PENDING
 CONFIRMED
 FAILED
}

model User {
 id String @id @default(cuid())
 name String
 phone String @unique
 passwordHash String
 role Role @default(CUSTOMER)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 profile CustomerProfile?
 customerOrders Order[] @relation("CustomerOrders")
 operatorOrders Order[] @relation("OperatorOrders")
 sessions Session[]
 notifications Notification[]
}
model CustomerProfile {
 id String @id @default(cuid())
 userId String @unique
 defaultLocation String?
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
}
model Session {
 id String @id @default(cuid())
 tokenHash String @unique
 userId String
 expiresAt DateTime
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,expiresAt])
}
model Order {
 id String @id @default(cuid())
 orderNumber String @unique
 customerId String
 operatorId String?
 status OrderStatus @default(REQUESTED)
 pickupLocation String
 deliveryLocation String
 instructions String?
 deliveryFee Int
 pricingSnapshot Json
 paymentStatus PaymentStatus @default(PENDING)
 createdAt DateTime @default(now())
 acceptedAt DateTime?
 completedAt DateTime?
 updatedAt DateTime @updatedAt
 customer User @relation("CustomerOrders",fields:[customerId],references:[id])
 operator User? @relation("OperatorOrders",fields:[operatorId],references:[id])
 items OrderItem[]
 payment Payment?
 @@index([customerId,createdAt])
 @@index([status,createdAt])
}
model OrderItem {
 id String @id @default(cuid())
 orderId String
 name String
 quantity Int
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
 @@index([orderId])
}
model PricingRule {
 id String @id @default(cuid())
 name String @unique
 startTime String
 endTime String
 price Int
 active Boolean @default(true)
}
model OperatorSettings {
 id String @id @default(cuid())
 acceptingRequests Boolean @default(true)
 weatherMode WeatherMode @default(NORMAL)
 operatingStart String @default("08:00")
 operatingEnd String @default("21:00")
 updatedAt DateTime @updatedAt
}
model Notification {
 id String @id @default(cuid())
 userId String
 type String
 title String
 message String
 read Boolean @default(false)
 createdAt DateTime @default(now())
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 @@index([userId,createdAt])
}
model Payment {
 id String @id @default(cuid())
 orderId String @unique
 amount Int
 method String @default("PAY_ON_DELIVERY")
 status PaymentStatus @default(PENDING)
 confirmedAt DateTime?
 order Order @relation(fields:[orderId],references:[id],onDelete:Cascade)
}
